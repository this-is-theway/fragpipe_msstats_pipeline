/*
========================================================================================
    FragPipe Proteomics Pipeline — nextflow.config
========================================================================================
*/

/*
----------------------------------------------------------------------------------------
    Default parameters
----------------------------------------------------------------------------------------
*/

params {

    // ---- Input / Output ----
    input                = ''          // Glob to MS files, e.g. '/data/raw/*.mzML'
    fasta                = ''          // Protein FASTA database
    experimental_design  = ''          // CSV: file, experiment, bioreplicate, data_type
    outdir               = 'results'
    thermorawfileparser  = ''

    // ---- FragPipe ----
    fragpipe_workflow    = ''          // Path to .workflow file
    fragpipe_manifest    = null          // (Optional) pre-made .fp-manifest
    fragpipe_threads     = 8
    fragpipe_ram         = 20           // GB

    // ---- MSstats / R analysis ----
    msstats_csv          = ''          // if set, skip RAW_TO_MZML/GENERATE_MANIFEST/FRAGPIPE and use this file
    rmd_template         = ''          // Path to run_msstats.Rmd
    scripts              = ''          // Path to R scripts directory
    comparisons_file     = ''          // CSV: condition_A, condition_B
    highlight_genes_file = ''          // (Optional) one gene name per line
    imputation_method    = 'AFT'      
    fdr_threshold        = 0.05
    log2fc_threshold     = 1.5
    fasta_source         = 'uniprot'   // "uniprot" or "ncbi" formats avalible

    // ---- Report ----
    report_title         = 'Proteomics Analysis Report'
    report_author        = 'Author Name'

    // ---- Local tool path ----
    fragpipe_bin         = ''          // Directory containing fragpipe binary
    python_bin = ''                 // Directory containing python binary

    // ---- Pipeline options ----
    help                 = false
    max_cpus             = 12
    max_memory           = '48.GB'
    max_time             = '72.h'
}

/*
----------------------------------------------------------------------------------------
    Process configuration by label
----------------------------------------------------------------------------------------
*/

process {

    // Defaults for all processes
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withLabel: 'process_medium' {
        cpus   = 12
        memory = '48.GB'
        time   = '8.h'
    }

    withLabel: 'process_high' {
        cpus   = { params.fragpipe_threads }
        memory = { "${params.fragpipe_ram}.GB" }
        time   = '48.h'
    }

    // ---- Container assignments per process ----
    withName: 'GENERATE_MANIFEST' {
        container = 'python:3.11-slim'
    }

    withName: 'FRAGPIPE' {
        // Build your own or use a community image that bundles:
        //   FragPipe, MSFragger, Philosopher, IonQuant, Python
        container = 'fragpipe/fragpipe:22.0'
    }

    withName: 'MSSTATS_REPORT' {
        // Must contain: R, rmarkdown, MSstats, tidyverse
        container = 'bioconductor/bioconductor_docker:devel'
    }
}

/*
----------------------------------------------------------------------------------------
    Profiles
----------------------------------------------------------------------------------------
    Usage:  nextflow run main.nf -profile docker
            nextflow run main.nf -profile singularity
            nextflow run main.nf -profile slurm,singularity
            nextflow run main.nf -profile test
*/

// Default: local execution, no containers
docker.enabled      = false
singularity.enabled = false
podman.enabled      = false
conda.enabled       = false
process.executor    = 'local'

profiles {

    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        // singularity.cacheDir = '/path/to/singularity/cache'
    }

    conda {
        conda.enabled  = true
        // Override containers with conda envs here if needed:
        // process { withName: 'FRAGPIPE'       { conda = 'environment_fragpipe.yml' } }
        // process { withName: 'MSSTATS_REPORT' { conda = 'environment_r.yml'        } }
    }

    // ---- HPC schedulers ----
    
}

/*
----------------------------------------------------------------------------------------
    Execution reports
----------------------------------------------------------------------------------------
*/

timeline.enabled = true
timeline.file    = "${params.outdir}/pipeline_info/timeline.html"

report.enabled   = true
report.file      = "${params.outdir}/pipeline_info/report.html"

trace.enabled    = true
trace.file       = "${params.outdir}/pipeline_info/trace.txt"
trace.fields     = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar'
trace.overwrite  = true

dag.enabled      = true
dag.file         = "${params.outdir}/pipeline_info/dag.html"

/*
----------------------------------------------------------------------------------------
    Manifest — pipeline metadata
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'fragpipe-proteomics-pipeline'
    author          = 'Autor Name'
    description     = 'Nextflow pipeline: FragPipe search → MSstats analysis → HTML report'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
