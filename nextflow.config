/*
========================================================================================
    FragPipe Proteomics Pipeline — nextflow.config
========================================================================================
*/

/*
----------------------------------------------------------------------------------------
    Default parameters
----------------------------------------------------------------------------------------
*/

params {

    // ---- Input / Output ----
    input                = ''          // Glob to MS files, e.g. '/data/raw/*.mzML'
    fasta                = ''          // Protein FASTA database
    experimental_design  = ''          // CSV: file, experiment, bioreplicate, data_type
    outdir               = 'results'

    // ---- FragPipe ----
    fragpipe_workflow    = ''          // Path to .workflow file
    fragpipe_manifest    = null          // (Optional) pre-made .fp-manifest
    fragpipe_threads     = 8
    fragpipe_ram         = 20           // GB

    // ---- MSstats / R analysis ----
    msstats_csv          = ''          // if set, skip RAW_TO_MZML/GENERATE_MANIFEST/FRAGPIPE and use this file
    rmd_template         = ''          // Path to run_msstats.Rmd
    scripts              = ''          // Path to R scripts directory
    comparisons_file     = ''          // CSV: condition_A, condition_B
    highlight_genes_file = ''          // (Optional) one gene name per line
    imputation_method    = 'ludovic'      
    fdr_threshold        = 0.05
    log2fc_threshold     = 2

    // ---- Report ----
    report_title         = 'Proteomics Analysis Report'
    report_author        = 'Author Name'
    logo_path            = ''

    // ---- Local tool path ----
    fragpipe_bin         = '/fragpipe_bin/fragpipe-24.0/fragpipe-24.0/bin'          // Directory containing fragpipe binary
    python_bin           = 'python3'          // Directory containing python binary

    // ---- Pipeline options ----
    help                 = false
    max_cpus             = 12
    max_memory           = '48.GB'
    max_time             = '72.h'

    // ---- Containers
    container_dir       = "{projectDir}/containers"
}

/*
----------------------------------------------------------------------------------------
    Process configuration by label
----------------------------------------------------------------------------------------
*/

process {

    // Defaults for all processes
    errorStrategy = 'retry'
    maxRetries    = 2

    withLabel: 'process_low' {
        cpus   = 2
        memory = '4.GB'
        time   = '1.h'
    }

    withLabel: 'process_medium' {
        cpus   = 12
        memory = '48.GB'
        time   = '8.h'
    }

    withLabel: 'process_high' {
        cpus   = { params.fragpipe_threads }
        memory = { "${params.fragpipe_ram}.GB" }
        time   = '48.h'
    }

    // ---- Container assignments per process ----
    withName: 'GENERATE_MANIFEST' {
         container = '${params.container_dir}/containers/fragpipe/fragpipe_24.0.sif'
    }

    withName: 'RAW_TO_MZML' {
        container = '${params.container_dir}/thermorawfileparser/thermorawfileparser_1.4.5.sif'
    }

    withName: 'FRAGPIPE' {
        container = '${params.container_dir}/fragpipe/fragpipe_24.0.sif'
    }

    withName: 'MSSTATS_REPORT' {
        container = '${params.container_dir}/msstats/msstats.sif'
    }
}

// ---------------------------------------------------------------------------
// Profiles
// ---------------------------------------------------------------------------

/*
    Usage:  nextflow run main.nf -profile local
            nextflow run main.nf -profile slurm
*/

profiles {
    local {
        executor {
            name   = 'local'
        }
    }

    slurm {
        executor {
            name            = 'slurm'
            queueSize       = params.slurm_queue_size
            submitRateLimit = '10 sec'
        }
        process {
            executor       = 'slurm'
            queue          = params.slurm_queue
            clusterOptions = params.slurm_cluster_options ?: null
        }
    }
}

/*
----------------------------------------------------------------------------------------
    Execution reports
----------------------------------------------------------------------------------------
*/

report {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_report_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}
timeline {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_timeline_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}
trace {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/execution_trace_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.txt"
    fields    = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,workdir'
}
dag {
    enabled   = true
    overwrite = true
    file      = "${params.outdir}/pipeline_info/pipeline_dag_${new java.util.Date().format('yyyy-MM-dd_HH-mm')}.html"
}

/*
----------------------------------------------------------------------------------------
    Manifest — pipeline metadata
----------------------------------------------------------------------------------------
*/

manifest {
    name            = 'fragpipe-proteomics-pipeline'
    author          = 'Autor Name'
    description     = 'Nextflow pipeline: FragPipe search → MSstats analysis → HTML report'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=23.04.0'
    version         = '1.0.0'
}
